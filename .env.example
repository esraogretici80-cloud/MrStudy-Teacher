# Firebase AI Logic & App Check are used for Gemini AI calls; no GEMINI_API_KEY is required.
# Optional for sideloaded Debug APK builds: register a Debug Token in Firebase Console > App Check
# and set FIREBASE_APPCHECK_DEBUG_TOKEN in AI Studio Secrets so the debug APK carries it automatically.
FIREBASE_APPCHECK_DEBUG_TOKEN=YOUR_FIREBASE_APPCHECK_DEBUG_TOKEN
