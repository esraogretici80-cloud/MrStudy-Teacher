<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/flashcard_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Flash Kart • Fizik"
        android:textColor="#22D3EE"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/flashcard_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="Newton'un 2. Yasası nedir?"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_fc_flip"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_btn"
            android:text="Çevir"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_fc_next"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_btn"
            android:text="Sonraki"
            android:textAllCaps="false"
            android:textColor="#22D3EE"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
