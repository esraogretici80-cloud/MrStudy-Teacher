<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Haftalık Ders Programım"
        android:textColor="#C084FC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/schedule_line_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="• Matematik • Denklemler"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/schedule_line_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="• Fen Bilimleri • Hücre"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/schedule_line_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="• Plan açmak için dokun"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:maxLines="1" />
</LinearLayout>
