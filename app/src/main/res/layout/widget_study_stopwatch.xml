<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Çalışma Kronometresi"
        android:textColor="#22D3EE"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/stopwatch_chrono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stopwatch_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Beklemede • Başlatmak için dokun"
        android:textColor="#CBD5E1"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_sw_start"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_btn"
            android:text="Başlat"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_sw_pause"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_btn"
            android:text="Duraklat"
            android:textAllCaps="false"
            android:textColor="#FBBF24"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_sw_finish"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_btn"
            android:text="Bitir"
            android:textAllCaps="false"
            android:textColor="#22D3EE"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
